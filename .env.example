# AHDD website env vars — example file.
#
# Deployment split: the static HTML/CSS/JS deploys to Cloudflare Pages,
# the api/* serverless functions deploy to a separate Vercel project
# (ahdd-website-yee1.vercel.app). These env vars live on the Vercel side.
#
# Copy to .env.local for `vercel dev`, and set the live values in the
# Vercel project's Environment Variables (Production / Preview / Development).
#
# Already-existing env vars (do NOT remove these in production):
OPENAI_API_KEY=sk-...                  # api/chatbot.js
ANTHROPIC_API_KEY=sk-ant-...           # api/smileAnalysis.mjs

# 2026-05-26 — Chatbot "Talk to a human" callback handoff.
# Server-only. The browser never sees this URL; api/callback.js proxies.
# Get this URL from GHL Workflow → "Callback Request Handoff" → Inbound
# Webhook trigger.
GHL_CALLBACK_WEBHOOK_URL=
